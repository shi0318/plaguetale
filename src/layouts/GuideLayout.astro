---
// 攻略文章布局 —— 内容集合 guides 的每篇 .md 都用它渲染。
// 面包屑 → 封面 → H1 → 正文 → 来源表。
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StatusBadge from '../components/StatusBadge.astro';
import MediaFigure from '../components/MediaFigure.astro';
import SourcePanel from '../components/SourcePanel.astro';
import { STATUS_META, type ConfidenceStatus } from '../data/confidence';
import { SOURCES, type SourceRef, type SourceKey } from '../data/sources';
import { formatDate } from '../utils/dates';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  heading?: string;
  description: string;
  category: 'guide' | 'characters' | 'collectibles' | 'skills' | 'walkthrough' | 'romance' | 'news';
  status: ConfidenceStatus;
  sourceKeys?: SourceKey[];
  // Accepted for compatibility with existing frontmatter; released pages do not render a pre-release banner.
  preRelease?: boolean;
  updatedAt: string;
  cover: string;
}

const {
  title,
  heading,
  description,
  category,
  status,
  sourceKeys = [],
  updatedAt,
  cover,
} = Astro.props;

const SEGMENT_LABEL: Record<string, string> = {
  guide: 'Guide',
  characters: 'Characters',
  collectibles: 'Collectibles',
  skills: 'Skills',
  walkthrough: 'Walkthrough',
  romance: 'Romance',
  news: 'News',
  'release-date': 'Release Date',
  story: 'Story',
  combat: 'Combat',
  puzzles: 'Puzzles',
};

const h1 = heading ?? title;
const titleize = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const segments = Astro.url.pathname.split('/').filter(Boolean);
const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  ...segments.map((seg, i) => {
    const url = '/' + segments.slice(0, i + 1).join('/') + '/';
    const name = i === segments.length - 1 ? h1 : (SEGMENT_LABEL[seg] ?? titleize(seg));
    return { name, url };
  }),
];

const meta = STATUS_META[status];
const sources: SourceRef[] = sourceKeys.map((k) => SOURCES[k]);
---

<Layout
  title={title}
  description={description}
  pageType={category === 'news' ? 'article' : 'article'}
  breadcrumbs={crumbs}
>
  <article class="container max-w-3xl py-10">
    <Breadcrumb items={crumbs} />

    <MediaFigure
      class="mt-6"
      src={cover}
      alt={`${h1} official cover image`}
      width={1920}
      height={1080}
      priority
      credit="Official Steam media used as the article cover."
    />

    <header class="mt-6 border-b border-white/10 pb-6">
      <div class="mb-3">
        <StatusBadge status={status} />
      </div>
      <h1 class="text-3xl font-black tracking-tight text-bone md:text-4xl">{h1}</h1>
      <p class="mt-3 text-lg text-fog">{description}</p>
      <p class="mt-4 text-sm text-fog">
        Updated <time datetime={updatedAt}>{formatDate(updatedAt)}</time> · {meta.label}
      </p>
    </header>

    <div class="prose-page mt-8">
      <slot />
    </div>

    <SourcePanel sources={sources} />
  </article>
</Layout>
