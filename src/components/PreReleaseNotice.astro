---
// Pre-release notice — soft banner, does not steal focus from the main content.
import { SITE } from '../data/site';
import { formatDate } from '../utils/dates';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside
  class:list={[
    'rounded-md border border-wheat/25 bg-wheat/[0.06] text-bone',
    compact ? 'px-3 py-2 text-xs' : 'px-4 py-3 text-sm',
  ]}
  role="note"
>
  <p>
    <span class="font-bold text-wheat">Pre-release guide.</span>
    {SITE.fullTitle} launches on <time datetime={SITE.releaseDate}>{formatDate(SITE.releaseDate)}</time>. Facts below are tagged with a confirmation
    status — anything drawn from trailers or the earlier Plague Tale games is flagged and will be
    replaced with verified data at launch.
  </p>
</aside>
