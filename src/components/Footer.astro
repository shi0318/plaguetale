---
import { NAV, SITE } from '../data/site';
import { CORE_SOURCES } from '../data/sources';
import { formatDate } from '../utils/dates';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-soil">
  <div class="container py-12">
    <div class="grid gap-8 md:grid-cols-[1.25fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-md border border-wheat/30 bg-wheat/10 text-sm font-black text-wheat">
            PT
          </span>
          <div>
            <p class="text-sm font-black uppercase text-bone">{SITE.name}</p>
            <p class="text-xs font-semibold uppercase text-fog">{SITE.tagline}</p>
          </div>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-fog">
          Independent fan guide for {SITE.fullTitle}. We publish confirmed facts from official sources first, then expand walkthrough, collectibles, and skill routes after Steam unlock.
        </p>
      </div>

      <nav aria-label="Guide links">
        <p class="text-xs font-black uppercase text-bone">Guides</p>
        <ul class="mt-3 space-y-2">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-fog hover:text-wheat">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Official links">
        <p class="text-xs font-black uppercase text-bone">Official sources</p>
        <ul class="mt-3 space-y-2">
          {CORE_SOURCES.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="nofollow noopener noreferrer" class="text-sm text-fog hover:text-wheat">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-xs leading-relaxed text-fog">
      <nav aria-label="Site information" class="mb-4 flex flex-wrap gap-x-5 gap-y-2">
        <a href="/about/" class="font-semibold text-fog hover:text-wheat">About</a>
        <a href="/privacy/" class="font-semibold text-fog hover:text-wheat">Privacy Policy</a>
        <a href="/contact/" class="font-semibold text-fog hover:text-wheat">Contact</a>
      </nav>
      <p>
        This site is not affiliated with or endorsed by {SITE.developer} or {SITE.publisher}. {SITE.fullTitle}, screenshots, names, and trademarks belong to their respective owners.
      </p>
      <p class="mt-2">
        Pages are last verified against official sources on <time datetime={SITE.lastVerified}>{formatDate(SITE.lastVerified)}</time>. Contact:
        <a href={`mailto:${SITE.contactEmail}`} class="text-wheat underline underline-offset-2">{SITE.contactEmail}</a>.
      </p>
      <p class="mt-2">&copy; {year} {SITE.name}.</p>
    </div>
  </div>
</footer>
