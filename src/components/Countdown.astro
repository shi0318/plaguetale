---
// Release-status badge — kept under the historical component name for the homepage import.
import { SITE, isReleased } from '../data/site';
import { formatReleaseDate } from '../utils/release-date.js';

const released = isReleased();
const releaseDate = formatReleaseDate(SITE.releaseDate);
---

<div
  class="inline-flex items-center gap-2 rounded-lg border border-sage/30 bg-sage/10 px-5 py-3 text-sm font-bold text-sage backdrop-blur-md"
  aria-label={released ? 'Release status: available now' : `Release date: ${releaseDate}`}
>
  <span class="h-2 w-2 rounded-full bg-sage" aria-hidden="true"></span>
  <span>{released ? 'Available now' : 'Release date'}</span>
  <span class="text-fog" aria-hidden="true">·</span>
  <time datetime={SITE.releaseDate}>{releaseDate}</time>
</div>
