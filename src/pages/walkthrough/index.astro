---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { ASSETS } from '../../data/assets';
import { CHAPTERS } from '../../data/chapter-guide';

const title = 'Resonance: A Plague Tale Legacy Walkthrough Guide';
const description =
  'Resonance walkthrough: fourteen chapters from Blood Ties to What Remains, with goals, combat notes, and collectible reminders.';
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Walkthrough', url: '/walkthrough/' },
];
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Walkthrough</p>
      <h1 class="section-title">Resonance: A Plague Tale Legacy walkthrough</h1>
      <p class="mt-3 text-lg text-fog">
        Fourteen chapters. Open a chapter for setting, goals, combat, and what to sweep before you leave.
      </p>
    </header>
    <div class="mt-8"><MediaFigure {...ASSETS.islandOverlook} /></div>
    <ol class="mt-10 grid gap-4 md:grid-cols-2">
      {
        CHAPTERS.map((ch) => (
          <li class="surface overflow-hidden p-0">
            <a href={`/walkthrough/${ch.slug}/`} class="block no-underline">
              <img src={ch.image} alt={ch.imageAlt} width="1920" height="1080" loading="lazy" decoding="async" class="h-40 w-full object-cover" />
              <div class="p-5">
                <span class="text-xl font-black text-wheat">Chapter {ch.number}: {ch.title}</span>
                <p class="mt-2 text-sm text-fog">{ch.setting}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 text-sm text-fog">
      Maps: <a href="/maps/" class="text-wheat underline">region list</a>. Collectibles:
      <a href="/collectibles/" class="text-wheat underline">totals and chapter hints</a>.
    </p>
  </div>
</Layout>
