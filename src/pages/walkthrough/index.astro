---
// Walkthrough hub — CollectionPage. Pre-release this is a framework; after Steam unlock it fills
// with real chapter routes. Honest about what is and isn't known.
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PreReleaseNotice from '../../components/PreReleaseNotice.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import SourcePanel from '../../components/SourcePanel.astro';
import { ASSETS } from '../../data/assets';
import { SOURCES } from '../../data/sources';

const title = 'Resonance: A Plague Tale Legacy Walkthrough Guide';
const description =
  'Resonance: A Plague Tale Legacy walkthrough hub covering story beats, locations, combat, and Minoan sphere light puzzles before Steam unlock.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Walkthrough', url: '/walkthrough/' },
];

const knownBeats = [
  {
    title: 'Arrival and pursuit',
    body:
      'Sophia is on the run, pursued by an army also drawn to the island to reclaim a mysterious treasure. Early hours establish the chase and the stakes.',
  },
  {
    title: "The Minotaur's Island maze",
    body:
      'You navigate a treacherous maze — deadly trials, treacherous trails, and puzzles — following in your crew’s footsteps using the notebook.',
  },
  {
    title: 'Light puzzles with the Minoan sphere',
    body:
      'A stolen Minoan sphere lets you manipulate light to solve ingenious puzzles, a force Daedalus wove into the island’s heart.',
  },
  {
    title: 'Two eras, entwined',
    body:
      'The story shifts between Sophia’s Middle Ages and ancient Minoan times, weaving two fate-linked heroes and the Macula’s legacy.',
  },
  {
    title: 'The hunt intensifies',
    body:
      'A restless presence hunts you through the depths. Some sections are about hiding and outsmarting it rather than fighting.',
  },
];
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />

    <div class="mt-4"><PreReleaseNotice /></div>

    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Walkthrough hub</p>
      <h1 class="section-title">Resonance: A Plague Tale Legacy walkthrough</h1>
      <p class="mt-3 text-lg text-fog">
        A complete chapter-by-chapter route cannot be verified before the game unlocks on
        <strong>August 27, 2026</strong>. Until then, this page answers what the official material
        actually establishes about the story, locations, combat, and puzzle systems — with no
        fabricated chapter names or objectives.
      </p>
    </header>

    <div class="mt-8">
      <MediaFigure {...ASSETS.islandTrail} />
    </div>

    <!-- Known story beats -->
    <section class="mt-12">
      <div class="mb-4 flex items-center gap-3">
        <h2 class="text-2xl font-black text-bone">Confirmed story beats</h2>
        <StatusBadge status="official" size="sm" />
      </div>
      <p class="max-w-3xl text-fog">
        These beats are drawn from the official Steam description. Exact chapter names, order, and
        objectives are not public yet, so we do not list numbered chapters until launch.
      </p>
      <ol class="mt-5 space-y-4">
        {
          knownBeats.map((beat, i) => (
            <li class="surface p-5">
              <div class="flex items-baseline gap-3">
                <span class="text-2xl font-black text-wheat/70">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="text-lg font-black text-bone">{beat.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-fog">{beat.body}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-12 surface p-6 md:p-8" aria-labelledby="walkthrough-now">
      <p class="section-kicker">Useful before launch</p>
      <h2 id="walkthrough-now" class="mt-2 text-2xl font-black text-bone">What you can prepare now</h2>
      <p class="mt-3 max-w-3xl text-fog">
        The official pages already give players a reliable starting map of the search intent: the
        Venice lagoon camp and carnival, the legendary Minoan Island, Sophia’s melee combat, and
        the Minoan sphere’s light manipulation. Use the linked guides for verified context rather
        than treating a preview as a finished route.
      </p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        <li class="surface-muted p-4"><a href="/locations/" class="font-bold text-wheat underline underline-offset-2">Locations and world guide</a><span class="mt-1 block text-sm text-fog">Confirmed Venice, the carnival, the lagoon camp, and Minoan Island references.</span></li>
        <li class="surface-muted p-4"><a href="/island-exploration-encounter-guide/" class="font-bold text-wheat underline underline-offset-2">Island exploration guide</a><span class="mt-1 block text-sm text-fog">A factual route-card method for recording encounters after launch.</span></li>
        <li class="surface-muted p-4"><a href="/minoan-sphere-light-puzzle-guide/" class="font-bold text-wheat underline underline-offset-2">Minoan sphere puzzle guide</a><span class="mt-1 block text-sm text-fog">Confirmed light-manipulation role, without invented beam sequences.</span></li>
        <li class="surface-muted p-4"><a href="/collectibles/" class="font-bold text-wheat underline underline-offset-2">Collectibles guide</a><span class="mt-1 block text-sm text-fog">What the notebook and official devblog reveal, and what awaits a hands-on checklist.</span></li>
      </ul>
    </section>

    <!-- Post-unlock plan -->
    <section class="mt-12 surface p-6 md:p-8">
      <p class="section-kicker">After Steam unlock</p>
      <h2 class="mt-2 text-2xl font-black text-bone">What we will verify first</h2>
      <ul class="mt-4 space-y-2.5 text-fog">
        <li class="flex gap-3"><span class="text-wheat">→</span> Verified chapter routes after the retail build provides the in-game chapter names and objectives.</li>
        <li class="flex gap-3"><span class="text-wheat">→</span> Collectible locations per chapter, cross-linked to the <a href="/collectibles/" class="text-wheat underline underline-offset-2">collectibles guide</a>.</li>
        <li class="flex gap-3"><span class="text-wheat">→</span> Puzzle solutions for the Minoan-sphere light sections.</li>
        <li class="flex gap-3"><span class="text-wheat">→</span> Boss and Presence-encounter tactics as they appear.</li>
        <li class="flex gap-3"><span class="text-wheat">→</span> New routes added as each section is played and independently rechecked.</li>
      </ul>
    </section>

    <!-- Related pages -->
    <section class="mt-12 surface p-6 md:p-8">
      <p class="section-kicker">Before you set off</p>
      <h2 class="mt-2 text-2xl font-black text-bone">Where the walkthrough will take you</h2>
      <p class="mt-3 text-fog">
        The settings are already confirmed, even if the routes are not. Our
        <a href="/locations/" class="text-wheat underline underline-offset-2">locations and world guide</a>
        covers the Venice lagoon camp, the carnival, and the Minoan island — including the real Greek
        sites Asobo built it from, and the artifacts that carry the island's history.
      </p>
    </section>

    <SourcePanel sources={[SOURCES.steam]} />
  </div>
</Layout>
