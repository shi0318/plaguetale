---
// Guide hub — CollectionPage aggregating every markdown guide plus the main topic hubs.
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuideCard from '../../components/GuideCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { ASSETS } from '../../data/assets';

const title = 'Resonance: A Plague Tale Legacy Guide Hub';
const description =
  'Browse Resonance: A Plague Tale Legacy guides for release date, PC requirements, characters, collectibles, combat, skills, platforms, and walkthroughs.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Guide', url: '/guide/' },
];

const CATEGORY_LABEL: Record<string, string> = {
  guide: 'Overview',
  characters: 'Characters',
  collectibles: 'Collectibles',
  skills: 'Skills & Combat',
  walkthrough: 'Walkthrough',
  romance: 'Romance',
  news: 'News',
};

const FALLBACK_COVER: Record<string, string> = {
  guide: ASSETS.islandTrail.src,
  characters: ASSETS.sophiaCombat.src,
  collectibles: ASSETS.minoanRuins.src,
  skills: ASSETS.lightPuzzle.src,
  walkthrough: ASSETS.enemyEncounter.src,
  romance: ASSETS.creatureShadow.src,
  news: ASSETS.hero.src,
};

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updatedAt.localeCompare(a.data.updatedAt) || a.id.localeCompare(b.id),
);
const PAGE_SIZE = 9;
const currentPage = 1;
const totalPages = Math.ceil(guides.length / PAGE_SIZE);
const visibleGuides = guides.slice(0, PAGE_SIZE);

// Static topic hubs that aren't markdown-driven
const hubs = [
  {
    href: '/release-date/',
    label: 'Overview',
    title: 'Release date, price & platform',
    desc: 'Released August 27, 2026 on Steam at USD 49.99. Confirmed facts, system requirements, and current store details.',
    cover: ASSETS.islandTrail.src,
    status: 'official' as const,
  },
  {
    href: '/characters/',
    label: 'Characters',
    title: 'Characters & story',
    desc: 'Sophia, Leni, Alec, Theseus, Daedalus, and the unnamed entity behind the island hunt.',
    cover: ASSETS.sophiaCombat.src,
    status: 'official' as const,
  },
  {
    href: '/collectibles/',
    label: 'Collectibles',
    title: 'Collectibles guide',
    desc: 'Collectible context, artifacts, and clearly labelled retail-build evidence for the released game.',
    cover: ASSETS.minoanRuins.src,
    status: 'prequel' as const,
  },
  {
    href: '/skills/',
    label: 'Skills & Combat',
    title: 'Combat & skills',
    desc: 'Dynamic melee, parries, tools, and the Minoan-sphere light puzzles.',
    cover: ASSETS.lightPuzzle.src,
    status: 'trailer' as const,
  },
  {
    href: '/walkthrough/',
    label: 'Walkthrough',
    title: 'Walkthrough plan',
    desc: 'Confirmed story beats plus chapter routes added only when the released game provides verifiable evidence.',
    cover: ASSETS.enemyEncounter.src,
    status: 'official' as const,
  },
];

function coverOf(g: (typeof guides)[number]) {
  return g.data.cover ?? FALLBACK_COVER[g.data.category] ?? ASSETS.islandTrail.src;
}
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />

    <header class="mb-8 max-w-3xl">
      <p class="section-kicker">Start here</p>
      <h1 class="section-title">Every Resonance: A Plague Tale Legacy guide</h1>
      <p class="mt-3 text-lg text-fog">
        Every card shows a confirmation status so you can separate official Resonance: A Plague
        Tale Legacy facts from series context, official features, and player reports. The list is sorted by
        the latest verified update, with the newest page first.
      </p>
    </header>

    <section aria-labelledby="topic-guides" class="mb-14">
      <div class="mb-5">
        <p class="section-kicker">Search by question</p>
        <h2 id="topic-guides" class="section-title">Resonance: A Plague Tale Legacy topic guides</h2>
        <p class="mt-3 max-w-3xl text-fog">
          Start with the answer you need: launch details, confirmed characters and story, the
          current collectibles scope, melee and light puzzles, or the walkthrough coverage. These
          hubs link to the detailed pages without adding extra navigation-only URLs.
        </p>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {hubs.map((hub) => (
          <GuideCard
            href={hub.href}
            title={hub.title}
            description={hub.desc}
            cover={hub.cover}
            label={hub.label}
            status={hub.status}
          />
        ))}
      </ul>
    </section>

    <section class="latest-guides" aria-label="Latest guides">
      <p class="section-kicker">Latest guides first</p>
      <h2 class="mt-2 mb-5 text-2xl font-black text-bone">New and recently updated</h2>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {visibleGuides.map((g) => (
          <GuideCard href={`/${g.id}/`} title={g.data.heading ?? g.data.title} description={g.data.description} cover={coverOf(g)} label={CATEGORY_LABEL[g.data.category] ?? g.data.category} status={g.data.status} />
        ))}
      </ul>
      <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/guide/" />
    </section>
  </div>
</Layout>
