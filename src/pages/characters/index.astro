---
// Characters hub — CollectionPage. Every character carries a confirmation status.
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import SourcePanel from '../../components/SourcePanel.astro';
import { CHARACTERS } from '../../data/characters';
import { EXTRA_CAST } from '../../data/cast';
import { CORE_SOURCES, SOURCES } from '../../data/sources';
import { ASSETS } from '../../data/assets';

const title = 'Resonance: A Plague Tale Legacy Characters Guide';
const description =
  'Resonance: A Plague Tale Legacy characters: Sophia, Leni, Alec, Theseus, Irene, Ezra, Faro, Asterion, Ariadne — roles, personality, background, skills, and weapons.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Characters', url: '/characters/' },
];

const officialCount = CHARACTERS.filter((c) => c.status === 'official').length;
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />

    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Cast &amp; story</p>
      <h1 class="section-title">Resonance: A Plague Tale Legacy characters</h1>
      <p class="mt-3 text-lg text-fog">
        This page tracks the named figures and entities confirmed in the official Steam store
        description and developer announcements — {officialCount} of {CHARACTERS.length} entries
        carry Official status. It does not turn an unnamed role, trailer inference, or earlier-game
        character into a confirmed Resonance cast member.
      </p>
    </header>

    <div class="mt-8">
      <MediaFigure {...ASSETS.sophiaPortrait} />
    </div>

    <div class="mt-10 space-y-6">
      {
        CHARACTERS.map((c) => (
          <article class="surface p-6" id={c.slug}>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-2xl font-black text-bone">{c.name}</h2>
                <p class="mt-1 text-sm font-bold uppercase tracking-[0.1em] text-wheat">{c.role}</p>
              </div>
              <StatusBadge status={c.status} size="sm" />
            </div>
            <p class="mt-4 text-fog">{c.summary}</p>
            <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm text-fog">
              {c.knownFacts.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-fog">Source: {c.sourceNote}</p>
            <p class="mt-3">
              <a href={`/characters/${c.slug}/`} class="text-sm font-bold text-wheat underline-offset-2 hover:underline">
                Full {c.name} profile →
              </a>
            </p>
          </article>
        ))
      }
    </div>

    <section class="mt-12">
      <h2 class="text-2xl font-black text-bone">Crew and Minoan names</h2>
      <p class="mt-3 max-w-3xl text-fog">
        Irene, Ezra, and Faro sit with Sophia’s plunderer crew. Asterion and Ariadne belong to the Minoan
        era with Theseus and Daedalus. Personality, skills, and weapons below are play notes for this wiki.
      </p>
      <div class="mt-6 space-y-6">
        {
          EXTRA_CAST.map((c) => (
            <article class="surface overflow-hidden p-0" id={c.slug}>
              <img src={c.image} alt={c.imageAlt} width="1920" height="1080" loading="lazy" decoding="async" class="h-48 w-full object-cover" />
              <div class="p-6">
              <h2 class="text-2xl font-black text-bone">{c.name}</h2>
              <p class="mt-1 text-sm font-bold uppercase tracking-[0.1em] text-wheat">{c.role}</p>
              <dl class="mt-4 grid gap-3 text-sm text-fog sm:grid-cols-2">
                <div>
                  <dt class="font-bold text-bone">Personality</dt>
                  <dd class="mt-1">{c.personality}</dd>
                </div>
                <div>
                  <dt class="font-bold text-bone">Background</dt>
                  <dd class="mt-1">{c.background}</dd>
                </div>
                <div>
                  <dt class="font-bold text-bone">Skills</dt>
                  <dd class="mt-1">{c.skills}</dd>
                </div>
                <div>
                  <dt class="font-bold text-bone">Weapons</dt>
                  <dd class="mt-1">{c.weapons}</dd>
                </div>
              </dl>
              <p class="mt-3">
                <a href={`/characters/${c.slug}/`} class="text-sm font-bold text-wheat underline-offset-2 hover:underline">
                  Full {c.name} profile →
                </a>
              </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="prose-page mt-12 max-w-3xl">
      <h2>What is confirmed right now</h2>
      <p>
        Official Steam text confirms Sophia as the protagonist, references "the entwined destinies
        of two heroes linked by fate" across two eras, and names Daedalus as the mythological figure
        who wove light into the island. Official Steam news adds Leni as Sophia’s friend, Alec as
        her father and the leader of her childhood plunderer camp, and Theseus as the legendary hero
        whose perspective is part of the Minoan-era story.
      </p>
      <p>
        The hostile entity is still unnamed in the tracked first-party material. Its role is not the
        same as Theseus: the store page describes a restless hunter in the island’s shadows, while
        the gameplay announcement identifies Theseus as the presence resonating within Sophia. Full
        bios, relationship choices, and final encounter details remain unconfirmed until the released
        game provides verifiable evidence.
      </p>

      <h2>More on the cast</h2>
      <ul>
        <li>
          <a href="/sophia-voice-actor/">Who plays Sophia</a> — Anna Demetriou returns from Requiem
          and performs the motion capture herself this time, and explains how the younger Sophia
          differs.
        </li>
        <li>
          <a href="/allies-and-crew/">Allies &amp; crew</a> — Leni, Sophia's father Alec, and the
          mythic hero Theseus, plus the confirmed Heritage Pack pre-order DLC contents.
        </li>
        <li>
          <a href="/minotaur-myth-explained/">The Minotaur myth explained</a> — Minos, Theseus and
          Ariadne, and the devblog line that pins down where Resonance actually begins.
        </li>
        <li>
          <a href="/story/">Story &amp; setting</a> — the two eras, the Macula's legacy, and the
          presence hunting Sophia through the island.
        </li>
        <li>
          <a href="/soundtrack/">Soundtrack &amp; composer</a> — Olivier Derivière on the Yayli
          Tambur, the Cypriot choir, and writing music around Sophia's fragility.
        </li>
      </ul>
    </section>

    <SourcePanel sources={[...CORE_SOURCES, SOURCES.steamNews]} />
  </div>
</Layout>
