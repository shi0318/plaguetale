---
// Privacy policy — analytics, advertising, cookies, contact (AdSense requirement).
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';
import { formatDate } from '../utils/dates';

const PRIVACY_UPDATED = '2026-11-16';

const title = 'Privacy Policy — Plague Tale Legacy Guide';
const description =
  'Privacy policy for this unofficial Resonance: A Plague Tale Legacy fan guide: Google Analytics, Google AdSense cookies, your choices, and contact details.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy/' },
];
---

<Layout title={title} description={description} pageType="article" breadcrumbs={crumbs}>
  <article class="prose-page container max-w-3xl py-10">
    <Breadcrumb items={crumbs} />

    <h1 class="text-3xl font-black tracking-tight text-bone md:text-4xl">Privacy Policy</h1>
    <p>Last updated: <time datetime={PRIVACY_UPDATED}>{formatDate(PRIVACY_UPDATED)}</time></p>

    <p>
      {SITE.name} ({SITE.url.replace('https://', '')}) is an unofficial fan guide to {SITE.fullTitle}.
      This policy explains what information is collected when you visit, who collects it, and the
      choices you have.
    </p>

    <h2>Information we collect</h2>
    <p>
      We do not offer accounts, comments, newsletters, or forms, and we do not ask for your name,
      address, or payment details. If you email us, we receive your email address and whatever
      you write, and we use it only to reply.
    </p>
    <p>
      Like most websites, the server and our third-party providers automatically receive technical
      data such as your IP address, browser type, device type, referring page, pages viewed, and
      approximate region.
    </p>

    <h2>Google Analytics</h2>
    <p>
      This site uses Google Analytics (Google Analytics 4) to understand which pages are read and
      how visitors find them. Google Analytics sets first-party cookies and collects usage data such
      as page views, session length, device and browser information, and approximate location. We
      see aggregated reports, not information that identifies you personally. Google processes this
      data under the
      <a href="https://policies.google.com/privacy" rel="nofollow noopener noreferrer" target="_blank">Google Privacy Policy</a>.
      You can opt out with the
      <a href="https://tools.google.com/dlpage/gaoptout" rel="nofollow noopener noreferrer" target="_blank">Google Analytics opt-out browser add-on</a>.
    </p>

    <h2>Advertising and Google AdSense</h2>
    <p>
      This site uses, or may use, Google AdSense to show advertising. Third-party vendors, including
      Google, use cookies to serve ads based on your prior visits to this website or other websites.
      Google's use of advertising cookies enables it and its partners to serve ads to you based on
      your visits to this site and/or other sites on the internet.
    </p>
    <ul>
      <li>
        You can opt out of personalised advertising from Google by visiting
        <a href="https://adssettings.google.com/" rel="nofollow noopener noreferrer" target="_blank">Google Ads Settings</a>.
      </li>
      <li>
        You can opt out of a third-party vendor's use of cookies for personalised advertising by visiting
        <a href="https://www.aboutads.info/choices/" rel="nofollow noopener noreferrer" target="_blank">www.aboutads.info/choices</a>.
      </li>
      <li>
        Learn more about how Google uses data from sites that use its services at
        <a href="https://policies.google.com/technologies/partner-sites" rel="nofollow noopener noreferrer" target="_blank">How Google uses information from sites or apps that use our services</a>.
      </li>
    </ul>
    <p>
      If you opt out of personalised ads, you may still see ads, but they will not be based on your
      browsing history.
    </p>

    <h2>Visitors in the EEA, UK, and Switzerland</h2>
    <p>
      Where the law requires it, including in the European Economic Area, the United Kingdom, and
      Switzerland, personalised advertising and non-essential cookies are only used after you give
      consent through a consent message shown by Google or a certified consent management platform.
      You can withdraw or change your consent at any time through that message or by clearing this
      site's cookies in your browser. You also have rights to access, correct, or delete personal
      data held about you; contact us at the address below and we will help, or direct you to the
      relevant provider.
    </p>

    <h2>Managing cookies</h2>
    <p>
      You can block or delete cookies in your browser settings. Blocking cookies will not stop the
      guides from working, but some measurement and advertising features may not function.
    </p>

    <h2>Children</h2>
    <p>
      This site is not directed at children under 13, and we do not knowingly collect personal
      information from them.
    </p>

    <h2>External links</h2>
    <p>
      Guides link to Steam, Focus Entertainment, Asobo Studio, and other sites. Those websites have
      their own privacy policies, and we are not responsible for their content or practices.
    </p>

    <h2>Changes to this policy</h2>
    <p>
      If this policy changes, we will update the date at the top of this page.
    </p>

    <h2>Contact</h2>
    <p>
      For privacy questions or data requests, email
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>. See also our
      <a href="/terms/">Terms of Use</a>.
    </p>
  </article>
</Layout>
