---
// Privacy policy — analytics, advertising, cookies, contact (AdSense requirement).
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';
import { formatDate } from '../utils/dates';

const title = 'Privacy Policy — Resonance: A Plague Tale Legacy Guide';
const description =
  'Privacy policy for this independent Resonance: A Plague Tale Legacy guide, covering analytics, advertising, cookies, external links, and contact details.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy/' },
];
---

<Layout title={title} description={description} pageType="article" breadcrumbs={crumbs}>
  <article class="prose-page container max-w-3xl py-10">
    <Breadcrumb items={crumbs} />

    <h1 class="text-3xl font-black tracking-tight text-bone md:text-4xl">Privacy Policy</h1>
    <p>Last updated: <time datetime={SITE.lastVerified}>{formatDate(SITE.lastVerified)}</time></p>

    <h2>Information we collect</h2>
    <p>
      This site may collect basic analytics data such as page views, referring pages, browser
      type, device type, and approximate region. We do not ask visitors to create accounts and
      we do not knowingly collect personal information.
    </p>

    <h2>Cookies and advertising</h2>
    <p>
      If analytics or advertising is enabled, third-party providers such as Google may use
      cookies or similar technologies to measure traffic and serve ads. Google's use of
      advertising cookies enables it and its partners to serve ads based on visits to this and
      other sites. You can manage or disable cookies through your browser settings.
    </p>

    <h2>External links</h2>
    <p>
      This site links to Steam, Focus Entertainment, Asobo Studio, and other official or
      relevant pages. Those websites have their own privacy policies, and we are not responsible
      for their content or practices.
    </p>

    <h2>Contact</h2>
    <p>
      For privacy questions, email
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
    </p>
  </article>
</Layout>
