---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { ASSETS } from '../../data/assets';
import { COLLECTIBLE_TYPES, COLLECTIBLE_TOTALS, CHAPTER_COLLECTIBLE_HINTS } from '../../data/collectible-log';

const title = 'Resonance: A Plague Tale Legacy Collectibles Guide';
const description =
  'Resonance collectibles: 8 Blades, 30 Charms, 37 Artefacts, 200 Resonant Points, with how to get them and a fourteen-chapter list.';
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Collectibles', url: '/collectibles/' },
];
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Completion</p>
      <h1 class="section-title">Resonance: A Plague Tale Legacy collectibles</h1>
      <p class="mt-3 text-lg text-fog">
        Four counters: {COLLECTIBLE_TOTALS.blades} Blades, {COLLECTIBLE_TOTALS.charms} Charms,{' '}
        {COLLECTIBLE_TOTALS.artefacts} Artefacts, {COLLECTIBLE_TOTALS.resonantPoints} Resonant Points.
        Story complete is not 100%. Use Story Select after Chapter 14.
      </p>
    </header>
    <div class="mt-8"><MediaFigure {...ASSETS.goldChamber} /></div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        COLLECTIBLE_TYPES.map((t) => (
          <article class="surface p-5">
            <h2 class="text-xl font-black text-bone">{t.name}</h2>
            <p class="mt-1 text-wheat">{t.count} total</p>
            <p class="mt-3 text-sm text-fog"><strong class="text-bone">How.</strong> {t.how}</p>
            <p class="mt-2 text-sm text-fog"><strong class="text-bone">Where.</strong> {t.where}</p>
          </article>
        ))
      }
    </div>

    <h2 class="mt-12 text-2xl font-black text-bone">Chapter list</h2>
    <ol class="mt-4 space-y-3">
      {
        CHAPTER_COLLECTIBLE_HINTS.map((ch) => (
          <li class="surface p-4">
            <a href={`/walkthrough/${ch.slug}/`} class="font-black text-wheat hover:underline">
              Chapter {ch.number}: {ch.title}
            </a>
            <p class="mt-1 text-sm text-fog">{ch.hint}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-sm text-fog">
      Related: <a href="/plague-tale-legacy-blades-heroes-graves/" class="text-wheat underline">Blades</a>,
      <a href="/plague-tale-legacy-charms-guide/" class="text-wheat underline">Charms</a>,
      <a href="/plague-tale-legacy-relics-present-past/" class="text-wheat underline">Relics</a>,
      <a href="/find-missed-artifacts/" class="text-wheat underline">missed artifacts</a>.
    </p>
  </div>
</Layout>
