---
// About page — who runs the site and what it covers (AdSense trust surface).
// Sourcing rules live on /editorial/ so guides don't repeat them.
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';

const title = 'About — Plague Tale Legacy Guide';
const description =
  'About this unofficial Resonance: A Plague Tale Legacy fan guide: what it covers, where its facts come from, and how to reach us.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
];

const coverage = [
  { href: '/walkthrough/', label: 'Walkthrough', text: 'all 14 chapters with collectible counts, Blade locations, bosses, and chapter fixes' },
  { href: '/plague-tale-legacy-collectibles-by-chapter/', label: 'Collectibles', text: '8 Blades, 37 Artefacts, 30 Charms, and 200 Resonance Points' },
  { href: '/achievements-guide/', label: 'Achievements', text: 'all 36 Steam achievements, with dated unlock rates and the missable ones' },
  { href: '/combat/', label: 'Combat', text: 'parries, attack colour cues, stealth versus fighting, and skill unlock order' },
  { href: '/characters/', label: 'Characters and story', text: 'Sophia, her crew, the Minotaur myth, and the prequel timeline' },
  { href: '/release-date/', label: 'Release and platforms', text: 'price, editions, PC requirements, and the October 6 update' },
];
---

<Layout title={title} description={description} pageType="article" breadcrumbs={crumbs}>
  <article class="container max-w-3xl py-10">
    <Breadcrumb items={crumbs} />

    <h1 class="text-3xl font-black tracking-tight text-bone md:text-4xl">About the Plague Tale Legacy Guide</h1>
    <p class="mt-3 text-lg text-fog">
      An unofficial, fan-made guide to {SITE.fullTitle}, the Asobo Studio prequel released on
      August 27, 2026.
    </p>

    <div class="prose-page mt-8">
      <h2>What this site is</h2>
      <p>
        {SITE.name} is an independent community resource for players of {SITE.developer}'s
        {SITE.fullTitle}. It is not affiliated with, endorsed by, or sponsored by
        {SITE.developer} or {SITE.publisher}. The aim is simple: answer the questions players
        actually search for in one well-organised place, with every number traceable to a source.
      </p>

      <h2>What we cover</h2>
      <ul>
        {
          coverage.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a> — {c.text}.
            </li>
          ))
        }
      </ul>
      <p>
        Every guide is also listed in the <a href="/guide/">guide hub</a>, newest first.
      </p>

      <h2>How the guides are researched</h2>
      <p>
        Facts come from the official Steam store page and news hub (App {SITE.steamAppId}),
        {SITE.developer} and {SITE.publisher} channels, Steam's achievement statistics, and player
        reports from Steam reviews and walkthrough notes. We have not run our own hands-on tests of
        the game, so we never present a claim as personally tested. Where a guide relies on player
        reports, it says so in the sentence, and each page carries a confirmation badge. The full
        rules, including how dated snapshots and patches are handled, are on the
        <a href="/editorial/">editorial policy</a> page.
      </p>

      <h2>Images</h2>
      <p>
        Screenshots and header art come from the {SITE.fullTitle} Steam store page and official media,
        used with attribution for guide purposes. Trademarks and game assets belong to their
        respective owners. To request removal of any content, use our <a href="/contact/">contact page</a>.
      </p>

      <h2>Corrections and contact</h2>
      <p>
        Patches change games, and we sometimes get things wrong. If you spot an error, email
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> with the page URL. See also
        the <a href="/terms/">Terms of Use</a> and <a href="/privacy/">Privacy Policy</a>.
      </p>
    </div>
  </article>
</Layout>
