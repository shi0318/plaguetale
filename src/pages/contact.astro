---
// Contact page — corrections, source updates, and image/removal requests (trust surface).
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CORE_SOURCES } from '../data/sources';
import { SITE } from '../data/site';

const title = 'Contact — Resonance: A Plague Tale Legacy Guide';
const description =
  'Contact this independent Resonance: A Plague Tale Legacy guide for corrections, official source updates, image concerns, and verified launch-day data.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];
---

<Layout title={title} description={description} pageType="article" breadcrumbs={crumbs}>
  <article class="container max-w-3xl py-10">
    <Breadcrumb items={crumbs} />

    <h1 class="text-3xl font-black tracking-tight text-bone md:text-4xl">Contact this guide</h1>
    <p class="mt-3 text-lg text-fog">
      Send corrections, official source updates, image concerns, or verified launch data to
      <a href={`mailto:${SITE.contactEmail}`} class="text-wheat underline underline-offset-2">{SITE.contactEmail}</a>.
    </p>

    <div class="prose-page mt-8">
      <h2>What helps most</h2>
      <ul>
        <li>A link to the official source or a screenshot as evidence.</li>
        <li>The exact page URL that needs an update.</li>
        <li>Game version and spoiler level for any route, collectible, or combat data.</li>
      </ul>

      <h2>Image and removal requests</h2>
      <p>
        Screenshots and header art are used for fan-site documentation with attribution to the
        {SITE.fullTitle} Steam store page. Trademarks and game assets belong to
        {SITE.developer} and {SITE.publisher}. To request removal of any content, email the
        address above and we will respond promptly.
      </p>

      <h2>Official links</h2>
      <ul>
        {CORE_SOURCES.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="nofollow noopener noreferrer">{source.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </article>
</Layout>
