---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { ASSETS } from '../../data/assets';
import { MASTERY_BRANCHES } from '../../data/mastery';

const title = 'Resonance: A Plague Tale Legacy Skills & Combat Guide';
const description =
  'Resonance skills: six mastery branches, one base skill and two paths each, eighteen nodes. Melee, parry, stealth, sphere, motion, craft.';
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Skills', url: '/skills/' },
];
---

<Layout title={title} description={description} pageType="collection" breadcrumbs={crumbs}>
  <div class="container py-10">
    <Breadcrumb items={crumbs} />
    <header class="mt-6 max-w-3xl">
      <p class="section-kicker">Skills &amp; combat</p>
      <h1 class="section-title">Resonance: A Plague Tale Legacy combat and skills</h1>
      <p class="mt-3 text-lg text-fog">
        Six mastery branches. Each has one base skill and two paths of two nodes — eighteen skills.
        Spend on the problem in front of you, not a fake best-build order.
      </p>
    </header>
    <div class="mt-8"><MediaFigure {...ASSETS.spherePuzzle} /></div>
    <div class="mt-10 space-y-8">
      {
        MASTERY_BRANCHES.map((branch) => (
          <article class="surface p-6">
            <h2 class="text-2xl font-black text-bone">{branch.name}</h2>
            <p class="mt-1 text-sm text-wheat">{branch.focus}</p>
            <p class="mt-4 text-sm text-fog">
              <strong class="text-bone">Base — {branch.base.name}.</strong> {branch.base.note}
            </p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              {branch.paths.map((path, i) => (
                <div class="surface-muted p-4">
                  <p class="text-xs font-bold uppercase tracking-[0.12em] text-wheat">Path {i + 1}</p>
                  <ol class="mt-2 list-decimal space-y-2 pl-4 text-sm text-fog">
                    {path.map((node) => (
                      <li>
                        <strong class="text-bone">{node.name}.</strong> {node.note}
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
    <p class="mt-8 text-sm text-fog">
      Weapons context: <a href="/weapons/" class="text-wheat underline">weapons</a>. Chapter pressure:
      <a href="/walkthrough/" class="text-wheat underline">walkthrough</a>.
    </p>
  </div>
</Layout>
